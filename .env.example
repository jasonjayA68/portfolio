# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your key never ends up on GitHub.

# From https://resend.com/api-keys (sign up with the Gmail address below)
RESEND_API_KEY=

# Where contact-form messages go. Optional: defaults to the email in src/data/site.ts.
# Without a verified domain, Resend only delivers to the address you signed up with.
CONTACT_TO_EMAIL=jasonjay.ababao1968@gmail.com
